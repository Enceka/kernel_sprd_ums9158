# Container runtime support (Docker / containerd / runc) for RongYue E5.
# Merged on top of sprd_qogirn6l_defconfig via TARGET_KERNEL_CONFIG.
#
# CONFIG_SYSVIPC and CONFIG_IP6_NF_NAT stay disabled: android-base.config
# forbids them and the build enforces VINTF kernel requirements. IPC
# namespaces are provided through POSIX message queues instead, and
# containers keep IPv4 NAT only.

# Namespaces
CONFIG_POSIX_MQUEUE=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# cgroup controllers and limits
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y

# Bridge networking for the default docker0 network
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# In-kernel virtio-net backend for KVM guests using a TAP device
CONFIG_VHOST_NET=y
